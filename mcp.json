{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "remember-this": {
      "type": "streamable-http",
      "url": "https://remember-this.io/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "defaultScopes": [
              "mcp:use"
            ]
          }
        }
      }
    }
  }
}
